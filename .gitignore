data/questions/bluebook.db
data/questions/bluebook-extracted.zip
data/questions/all_questions.json
data/questions/*.md
data/questions/stats.json

# ---- superseded duplicates (sections.json points to the .min files) ----
data/questions/family_medicine_questions.json
data/questions/family_medicine_questions (1).json

# ---- internal tooling ----
.mimosa/

# ---- recall source material: private scans (student handwriting, names) ----
# the app serves the curated data/recalls.json only
docs/exam-recalls/

# ---- recall build intermediates (regenerable by tools/*_recall*.py) ----
# only the final data/recalls.json is a runtime file
data/recalls_verdicts/

# ---- OS / editor noise ----
Thumbs.db
Desktop.ini
.DS_Store
*.log

# ---- promo video workspace (sources + renders; never part of the deployed site) ----
promo/

# ---- deploy upload config: short-lived Hostinger auth keys, never committed ----
tools/.deploy-upload.json
